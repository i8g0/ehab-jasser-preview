{#
  Header: announcement marquee, transparent-over-hero bar, full-screen menu.
  The menu body is Salla's <salla-menu> so the merchant edits links from the dashboard.
#}
{% set announcements = [] %}
{% for key in ['announcement_1', 'announcement_2', 'announcement_3'] %}
    {% if theme.settings.get(key) %}{% set announcements = announcements|merge([theme.settings.get(key)]) %}{% endif %}
{% endfor %}

{% if announcements|length %}
<div class="ej-announce" aria-label="{{ store.name }}">
    <div class="ej-announce__track">
        {% for round in 1..4 %}
            {% for a in announcements %}
                <span>{{ a }}</span><i aria-hidden="true">✦</i>
            {% endfor %}
        {% endfor %}
    </div>
</div>
{% endif %}

<header class="ej-header" data-ej-header>
    <div class="ej-header__bar">
        <div class="ej-header__side">
            <button class="ej-icon-btn ej-header__menu" type="button" data-ej-menu-open aria-label="{{ trans('ej.open_menu') }}" aria-expanded="false" aria-controls="ej-menu">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h12"/></svg>
                <span class="ej-header__label">{{ trans('ej.menu') }}</span>
            </button>
        </div>

        <a class="ej-header__logo" href="{{ store.url }}" aria-label="{{ store.name }}">
            <img src="{{ store.logo }}" alt="{{ store.name }}" width="64" height="64" fetchpriority="high">
        </a>

        <div class="ej-header__side ej-header__side--end">
            <button class="ej-icon-btn" type="button" data-ej-search aria-label="{{ trans('ej.search') }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            </button>
            <a class="ej-icon-btn ej-header__cart" href="{{ link('cart') }}" data-ej-cart-open data-ej-cart-target aria-label="{{ trans('ej.cart') }}">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                <span class="ej-badge" data-ej-cart-count hidden>0</span>
            </a>
        </div>
    </div>
    <span class="ej-header__progress" data-ej-progress aria-hidden="true"></span>
</header>

<div class="ej-menu" id="ej-menu" data-ej-menu role="dialog" aria-modal="true" aria-label="{{ trans('ej.menu') }}" hidden>
    <div class="ej-menu__inner">
        <div class="ej-menu__top">
            <img src="{{ store.logo }}" alt="" width="56" height="56">
            <button class="ej-icon-btn" type="button" data-ej-menu-close aria-label="{{ trans('ej.close') }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
        <nav class="ej-menu__nav">
            <salla-menu source="header"></salla-menu>
        </nav>
        <p class="ej-menu__foot">
            <span class="ej-latin">EHAB JASSER · PARFUMS</span>
            <span>{{ theme.settings.get('payment_line') }}</span>
        </p>
    </div>
</div>
