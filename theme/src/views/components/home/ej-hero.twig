{#
  Cinematic scenes: full-screen video (or image) scenes stacked on the scroll. Each next scene is
  uncovered from beneath the current one with depth parallax; titles rise as a scene takes the stage.
| Variable                 | Type     | Description                                                       |
|--------------------------|----------|-------------------------------------------------------------------|
| component.slides         | object[] | video, video_mobile (mp4 URLs), image (poster / fallback), tone,  |
|                          |          | eyebrow, title, accent, button, url, loop_start (seconds)         |
| position                 | int      |                                                                   |
#}
{% set total = component.slides|length %}
<section class="ej-scenes" component-id="{{ componentId }}" data-ej-scenes aria-label="{{ store.name }}" style="--scenes: {{ total }}">
    {% for slide in component.slides %}
        {% set tone %}{% include 'components.ej.pick' with {v: slide.tone} %}{% endset %}
        {% set tone = tone|trim ?: 'dark' %}
        <article class="ej-scene ej-scene--{{ tone }}{{ slide.video ? ' ej-scene--video' : '' }}{{ loop.first ? ' is-current' : '' }}" data-scene="{{ loop.index0 }}" data-tone="{{ tone }}">
            <div class="ej-scene__media" data-scene-media>
                <div class="ej-scene__drift">
                    {% if slide.image %}
                        <picture>
                            {% if slide.image_mobile %}<source media="(orientation: portrait)" srcset="{{ slide.image_mobile }}">{% endif %}
                            <img class="ej-scene__img" src="{{ slide.image }}" alt="{{ slide.title }} {{ slide.accent }}" {{ loop.first ? 'fetchpriority="high"' : 'loading="lazy"' }}>
                        </picture>
                    {% endif %}
                    {% if slide.video %}
                        {% if loop.first %}
                            {# the opening film is in the HTML itself, so the phone starts fetching and playing it
                               while the page is still loading, without waiting for any script #}
                            <video class="ej-scene__video" autoplay muted playsinline webkit-playsinline loop preload="auto" aria-hidden="true"
                                   {% if slide.image %}poster="{{ slide.image }}"{% endif %}
                                   data-src="{{ slide.video }}" data-src-mobile="{{ slide.video_mobile }}" data-poster="{{ slide.image }}" data-poster-mobile="{{ slide.image_mobile }}" data-loop-start="{{ slide.loop_start ?: 0 }}">
                                {% if slide.video_mobile %}<source src="{{ slide.video_mobile }}" type="video/mp4" media="(orientation: portrait)">{% endif %}
                                <source src="{{ slide.video }}" type="video/mp4">
                            </video>
                        {% else %}
                            <video class="ej-scene__video" muted playsinline loop preload="none" aria-hidden="true"
                                   data-poster="{{ slide.image }}" data-poster-mobile="{{ slide.image_mobile }}"
                                   data-src="{{ slide.video }}" data-src-mobile="{{ slide.video_mobile }}" data-loop-start="{{ slide.loop_start ?: 0 }}"></video>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
            <span class="ej-scene__shade" aria-hidden="true"></span>
            <span class="ej-scene__sweep" aria-hidden="true"></span>
            {% if loop.first %}<canvas class="ej-hero__dust" data-ej-dust aria-hidden="true"></canvas>{% endif %}

            <div class="ej-scene__copy">
                <span class="ej-scene__count ej-latin" aria-hidden="true"><b>{{ '%02d'|format(loop.index) }}</b><i></i>{{ '%02d'|format(total) }}</span>
                {% if slide.eyebrow %}<span class="ej-eyebrow ej-scene__eyebrow">{{ slide.eyebrow }}</span>{% endif %}
                {% if loop.first %}<h1 class="ej-scene__title">{% else %}<h2 class="ej-scene__title">{% endif %}
                    <span class="ej-scene__line" data-words>{{ slide.title }}</span>
                    {% if slide.accent %}<span class="ej-scene__line ej-scene__line--accent" data-words>{{ slide.accent }}</span>{% endif %}
                {% if loop.first %}</h1>{% else %}</h2>{% endif %}
                {% if slide.button %}
                    <a class="ej-btn {{ tone == 'light' ? 'ej-btn--ink' : 'ej-btn--glass' }} ej-scene__cta" href="{{ slide.url ?: '#shop' }}" data-magnetic>
                        <span>{{ slide.button }}</span>
                    </a>
                {% endif %}
            </div>
        </article>
    {% endfor %}

    {% if total > 1 %}
        <nav class="ej-scenes__dots" data-scene-dots aria-label="{{ store.name }}">
            <span class="ej-scenes__rail" aria-hidden="true"><span data-scene-progress></span></span>
            {% for slide in component.slides %}
                <button type="button" class="ej-scenes__dot{{ loop.first ? ' is-active' : '' }}" data-scene-go="{{ loop.index0 }}" aria-label="{{ slide.title }}" aria-current="{{ loop.first ? 'true' : 'false' }}">
                    <span class="ej-scenes__label">{{ slide.title }}</span>
                </button>
            {% endfor %}
        </nav>
    {% endif %}

    {# shown only when the phone blocks autoplay (Low Power Mode): any touch starts the films #}
    <button type="button" class="ej-scenes__tap" aria-label="{{ trans('ej.tap_to_play') }}">
        <i aria-hidden="true"></i><span>{{ trans('ej.tap_to_play') }}</span>
    </button>

    <span class="ej-hero__scroll ej-latin" aria-hidden="true">{{ trans('ej.scroll') }}<i></i></span>
</section>
